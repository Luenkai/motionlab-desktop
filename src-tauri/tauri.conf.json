{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MotionLab",
  "version": "0.1.0",
  "identifier": "com.motionlab.live2d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MotionLab — Live2D Movement Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
